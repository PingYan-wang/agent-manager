{
  "version": 2,
  "port": 8788,
  "upstreamTimeoutMs": 600000,
  "providers": {
    "volc": {
      "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
      "apiKey": "sk-your-volcengine-key",
      "label": "火山方舟",
      "cost": 1.2
    },
    "reverix": {
      "baseUrl": "https://reverix.ai/v1",
      "apiKey": "sk-your-reverix-key",
      "label": "Reverix",
      "cost": 15
    },
    "devin": {
      "baseUrl": "http://127.0.0.1:8790/v1",
      "apiKey": "devin-local-key",
      "label": "Devin CLI 反代",
      "cost": 0,
      "capabilities": {
        "tools": false,
        "stream": false,
        "maxChars": 64000,
        "maxMessages": 100
      }
    },
    "trae": {
      "baseUrl": "http://127.0.0.1:7864/v1",
      "apiKey": "trae-local-key",
      "label": "Trae SOLO API",
      "cost": 0,
      "capabilities": {
        "maxChars": 120000,
        "maxMessages": 200
      }
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "[REDACTED]",
      "label": "DeepSeek 官方",
      "keepFields": [
        "reasoning_content"
      ],
      "_comment": "新版推理模型要求把 messages[].reasoning_content 原样回传，剥掉会 400 must be passed back"
    }
  },
  "routes": {
    "simple": {
      "strategy": "priority",
      "chain": [
        {
          "provider": "volc",
          "models": [
            "deepseek-v4.1-flash"
          ]
        },
        {
          "provider": "trae",
          "models": [
            "glm-5-turbo",
            "DeepSeek-V4-Flash-Official"
          ]
        },
        {
          "provider": "devin",
          "models": [
            "swe-2-flash-high"
          ]
        }
      ]
    },
    "coding": {
      "strategy": "priority",
      "chain": [
        {
          "provider": "volc",
          "models": [
            "kimi-k3.1-pro",
            "doubao-seed-2.1-pro"
          ]
        },
        {
          "provider": "devin",
          "models": [
            "swe-2-high"
          ]
        },
        {
          "provider": "trae",
          "models": [
            "kimi-k2.7-code",
            "seed-code-pro-0430"
          ]
        },
        {
          "provider": "reverix",
          "models": [
            "claude-opus-5-5",
            "gpt-6.1-sol"
          ]
        }
      ]
    },
    "complex": {
      "strategy": "priority",
      "chain": [
        {
          "provider": "reverix",
          "models": [
            "claude-opus-5-5",
            "gpt-6.1-sol"
          ]
        },
        {
          "provider": "devin",
          "models": [
            "swe-2-high"
          ]
        },
        {
          "provider": "volc",
          "models": [
            "glm-5.3"
          ]
        },
        {
          "provider": "trae",
          "models": [
            "Doubao-Seed-2.1-Pro",
            "glm-5.3"
          ]
        }
      ]
    },
    "expert": {
      "strategy": "priority",
      "chain": [
        {
          "provider": "reverix",
          "models": [
            "claude-fable-5-2",
            "claude-opus-5-5"
          ]
        },
        {
          "provider": "devin",
          "models": [
            "swe-2-high"
          ]
        },
        {
          "provider": "volc",
          "models": [
            "glm-5.3"
          ]
        },
        {
          "provider": "trae",
          "models": [
            "glm-5.3",
            "DeepSeek-V4-Pro"
          ]
        }
      ]
    }
  },
  "reserve": [
    {
      "provider": "reverix",
      "models": [
        "gpt-6.1-sol"
      ]
    },
    {
      "provider": "volc",
      "models": [
        "glm-5.3"
      ]
    },
    {
      "provider": "trae",
      "models": [
        "glm-5.3"
      ]
    }
  ],
  "guard": {
    "upgradeOnTools": true,
    "toolsMin": 1,
    "toolsUpgradeTo": "coding",
    "fastFailStaleMs": 45000,
    "fastFailAfterRetries": 2,
    "fastFailMinWaitMs": 120000
  },
  "retryPolicy": {
    "windowMs": 300000,
    "escalateAfter": 2,
    "crossTier": true,
    "tiers": [
      "simple",
      "coding",
      "complex",
      "expert"
    ]
  },
  "breaker": {
    "quotaMs": 900000,
    "authMs": 3600000,
    "rateMs": 60000,
    "serverMs": 60000,
    "networkMs": 30000,
    "modelMs": 600000
  },
  "classifier": {
    "mode": "cloud",
    "route": "simple",
    "model": ""
  },
  "budgets": {
    "reverix.ai": {
      "usd": 20
    }
  }
