<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mcphub</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__MCPHUB_PKG__/bin/cli.js</string>
  </array>
  <key>WorkingDirectory</key><string>__HUB_DATA__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__NODE_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>ADMIN_PASSWORD</key><string>__ADMIN_PASSWORD__</string>
    <key>PORT</key><string>3000</string>
    <key>API_RATE_LIMIT_MAX</key><string>0</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HUB_DATA__/mcphub.log</string>
  <key>StandardErrorPath</key><string>__HUB_DATA__/mcphub.log</string>
</dict>
</plist>
